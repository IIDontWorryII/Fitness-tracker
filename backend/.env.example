# --- GitHub sign-in (OAuth) — optional ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:4000/api/auth/oauth/github/callback

# --- Passkeys (WebAuthn) — optional; defaults to "localhost" ---
RP_ID=localhost
