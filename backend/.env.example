# --- Core ---
PORT=4000
MONGO_URI=mongodb://localhost:27017/fitness-app
SESSION_SECRET=your-secret-here

# --- Google sign-in (OIDC) — optional ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
